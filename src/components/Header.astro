---
import { SITE_CONFIG } from '../config';
import { getRelativeUrl } from '../utils/url';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-[#e8e8e8] transition-all">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- ロゴとブログ名 -->
    <a href={getRelativeUrl('/')} class="flex items-center gap-2.5 group">
      <!-- note風スクエアアイコン -->
      <div class="w-8 h-8 rounded-lg bg-[#2cb696] flex items-center justify-center text-white font-bold text-lg shadow-sm group-hover:bg-[#279d81] transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9" />
          <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
        </svg>
      </div>
      <span class="font-bold text-gray-900 text-base sm:text-lg tracking-tight group-hover:text-[#2cb696] transition-colors">
        {SITE_CONFIG.title}
      </span>
    </a>

    <!-- ナビゲーションメニュー -->
    <nav class="flex items-center gap-1 sm:gap-4 text-sm font-medium text-gray-600">
      <a 
        href={getRelativeUrl('/')} 
        class={`px-2.5 py-1.5 rounded-md hover:text-[#2cb696] hover:bg-emerald-50/60 transition-colors ${currentPath === '/' ? 'text-[#2cb696] font-semibold' : ''}`}
      >
        ホーム
      </a>
      <a 
        href={getRelativeUrl('/tags')} 
        class={`px-2.5 py-1.5 rounded-md hover:text-[#2cb696] hover:bg-emerald-50/60 transition-colors ${currentPath.startsWith('/tags') ? 'text-[#2cb696] font-semibold' : ''}`}
      >
        タグ
      </a>
      <a 
        href={getRelativeUrl('/about')} 
        class={`px-2.5 py-1.5 rounded-md hover:text-[#2cb696] hover:bg-emerald-50/60 transition-colors ${currentPath.startsWith('/about') ? 'text-[#2cb696] font-semibold' : ''}`}
      >
        著者
      </a>

      <!-- 検索モーダルトリガー -->
      <button 
        id="search-btn"
        aria-label="記事を検索"
        class="p-2 text-gray-500 hover:text-gray-800 hover:bg-gray-100 rounded-full transition-colors ml-1"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <!-- GitHubリポジトリリンク -->
      <a 
        href={SITE_CONFIG.githubUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        aria-label="GitHub Repository"
        class="hidden sm:inline-flex p-2 text-gray-500 hover:text-gray-900 hover:bg-gray-100 rounded-full transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
    </nav>
  </div>
</header>

<!-- 検索モーダル -->
<div id="search-modal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-sm flex items-start justify-center pt-20 px-4">
  <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full overflow-hidden border border-gray-200">
    <div class="p-4 border-b border-gray-100 flex items-center gap-3">
      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        id="search-input" 
        type="text" 
        placeholder="タイトルやタグで検索..." 
        class="w-full text-base outline-none text-gray-800 placeholder-gray-400"
        autocomplete="off"
      />
      <button id="search-close" class="text-gray-400 hover:text-gray-600 p-1 rounded-md text-xs font-semibold bg-gray-100 px-2">ESC</button>
    </div>
    <div id="search-results" class="max-h-80 overflow-y-auto divide-y divide-gray-100 p-2 text-sm text-gray-600">
      <div class="py-8 text-center text-gray-400">キーワードを入力して記事を探せます</div>
    </div>
  </div>
</div>

<script>
  // 検索モーダルの動作
  const searchBtn = document.getElementById('search-btn');
  const searchModal = document.getElementById('search-modal');
  const searchClose = document.getElementById('search-close');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchResults = document.getElementById('search-results');

  let postsData: Array<{ title: string; description: string; slug: string; tags: string[] }> = [];

  async function loadPostsIndex() {
    if (postsData.length > 0) return;
    try {
      const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
      const res = await fetch(`${baseUrl}/search-index.json`);
      if (res.ok) {
        postsData = await res.json();
      }
    } catch (e) {
      console.error('Failed to load search index:', e);
    }
  }

  function openSearch() {
    searchModal?.classList.remove('hidden');
    searchInput?.focus();
    loadPostsIndex();
  }

  function closeSearch() {
    searchModal?.classList.add('hidden');
    if (searchInput) searchInput.value = '';
    if (searchResults) searchResults.innerHTML = '<div class="py-8 text-center text-gray-400">キーワードを入力して記事を探せます</div>';
  }

  searchBtn?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);

  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) closeSearch();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
      closeSearch();
    }
    // Ctrl+K または Cmd+K で検索を開く
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
    if (!searchResults) return;

    if (!query) {
      searchResults.innerHTML = '<div class="py-8 text-center text-gray-400">キーワードを入力して記事を探せます</div>';
      return;
    }

    const matched = postsData.filter(post => 
      post.title.toLowerCase().includes(query) ||
      post.description.toLowerCase().includes(query) ||
      post.tags.some(t => t.toLowerCase().includes(query))
    );

    if (matched.length === 0) {
      searchResults.innerHTML = '<div class="py-8 text-center text-gray-400">一致する記事が見つかりませんでした</div>';
      return;
    }

    const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
    searchResults.innerHTML = matched.map(post => `
      <a href="${baseUrl}/posts/${post.slug}/" class="block p-3 rounded-lg hover:bg-emerald-50/70 transition-colors">
        <h4 class="font-bold text-gray-900">${post.title}</h4>
        <p class="text-xs text-gray-500 mt-1 line-clamp-1">${post.description}</p>
        <div class="flex gap-2 mt-2">
          ${post.tags.map(t => `<span class="text-[11px] text-[#2cb696] font-medium bg-[#eaf7f4] px-1.5 py-0.5 rounded">#${t}</span>`).join('')}
        </div>
      </a>
    `).join('');
  });
</script>

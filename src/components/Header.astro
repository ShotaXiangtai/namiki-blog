---
import { SITE_CONFIG } from '../config';
import { getRelativeUrl } from '../utils/url';
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = currentPath.startsWith(base) ? currentPath.slice(base.length) || '/' : currentPath;

const navLinks = [
  { href: '/', label: 'ホーム', active: path === '/', mobile: false },
  { href: '/tags', label: 'タグ', active: path.startsWith('/tags'), mobile: true },
  { href: '/about', label: '著者', active: path.startsWith('/about'), mobile: true },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-canvas/80 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-3 px-4 sm:px-6">
    <!-- ロゴ -->
    <a href={getRelativeUrl('/')} class="group flex min-w-0 items-center gap-2.5">
      <img
        src={getRelativeUrl(SITE_CONFIG.avatar)}
        alt=""
        width="32"
        height="32"
        class="size-8 shrink-0 rounded-full object-cover ring-1 ring-line"
      />
      <span class="truncate text-[0.9375rem] font-bold tracking-tight text-ink transition-colors group-hover:text-accent-ink sm:text-base">
        {SITE_CONFIG.title}
      </span>
    </a>

    <!-- ナビゲーション -->
    <nav aria-label="メインメニュー" class="flex shrink-0 items-center gap-0.5 text-sm sm:gap-1">
      {navLinks.map(({ href, label, active, mobile }) => (
        <a
          href={getRelativeUrl(href)}
          aria-current={active ? 'page' : undefined}
          class:list={[
            'items-center rounded-full px-3 py-1.5 font-medium text-ink-soft transition-colors hover:bg-subtle hover:text-ink aria-[current=page]:bg-subtle aria-[current=page]:text-ink',
            mobile ? 'inline-flex' : 'hidden sm:inline-flex',
          ]}
        >
          {label}
        </a>
      ))}

      <button
        id="search-open"
        type="button"
        aria-label="記事を検索"
        aria-haspopup="dialog"
        class="ml-1 inline-flex items-center gap-2 rounded-full border border-line bg-surface p-2 text-ink-muted transition-colors hover:border-line-strong hover:text-ink md:py-1.5 md:pl-3 md:pr-1.5"
      >
        <Icon name="search" class="size-4" />
        <span class="hidden text-[0.8125rem] md:inline">検索</span>
        <kbd id="search-shortcut" class="kbd hidden md:inline-flex">Ctrl K</kbd>
      </button>

      <a
        href={SITE_CONFIG.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub リポジトリ"
        class="hidden rounded-full p-2 text-ink-muted transition-colors hover:bg-subtle hover:text-ink sm:inline-flex"
      >
        <Icon name="github" class="size-[1.125rem]" />
      </a>
    </nav>
  </div>
</header>

<!-- 検索ダイアログ -->
<dialog id="search-dialog" class="search-dialog" aria-label="記事を検索">
  <div class="flex items-center gap-3 border-b border-line px-4">
    <Icon name="search" class="size-5 shrink-0 text-ink-muted" />
    <input
      id="search-input"
      type="search"
      placeholder="タイトル・本文の概要・タグで検索"
      autocomplete="off"
      autofocus
      class="h-14 w-full bg-transparent text-base text-ink outline-none placeholder:text-ink-muted [&::-webkit-search-cancel-button]:hidden"
    />
    <button id="search-close" type="button" class="kbd shrink-0 cursor-pointer hover:text-ink">Esc</button>
  </div>
  <div id="search-results" class="max-h-[min(60vh,28rem)] overflow-y-auto p-2" aria-live="polite"></div>
</dialog>

<script>
  type SearchPost = { title: string; description: string; slug: string; tags: string[]; date: string };

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('search-open');
  const closeBtn = document.getElementById('search-close');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const results = document.getElementById('search-results');
  const shortcut = document.getElementById('search-shortcut');
  const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

  if (shortcut && /Mac|iPhone|iPad/.test(navigator.platform)) {
    shortcut.textContent = '⌘K';
  }

  let posts: SearchPost[] = [];
  let loading: Promise<void> | null = null;

  function loadIndex() {
    loading ??= fetch(`${baseUrl}/search-index.json`)
      .then((res) => (res.ok ? res.json() : []))
      .then((data: SearchPost[]) => {
        posts = data;
      })
      .catch((e) => console.error('Failed to load search index:', e));
    return loading;
  }

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const formatDate = (iso: string) =>
    new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'short', day: 'numeric' }).format(new Date(iso));

  function renderMessage(text: string) {
    if (results) results.innerHTML = `<p class="px-3 py-10 text-center text-sm text-ink-muted">${text}</p>`;
  }

  function renderList(list: SearchPost[], heading: string) {
    if (!results) return;
    results.innerHTML =
      `<p class="px-3 pb-1 pt-2 text-xs font-bold text-ink-muted">${heading}</p>` +
      list
        .map(
          (post) => `
        <a href="${baseUrl}/posts/${encodeURIComponent(post.slug)}/" class="block rounded-xl px-3 py-2.5 transition-colors hover:bg-subtle focus-visible:bg-subtle">
          <span class="block font-bold leading-snug text-ink">${escapeHtml(post.title)}</span>
          <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-muted">
            <time>${formatDate(post.date)}</time>
            ${post.tags
              .slice(0, 3)
              .map((t) => `<span class="text-accent-ink">#${escapeHtml(t)}</span>`)
              .join('')}
          </span>
        </a>`,
        )
        .join('');
  }

  function update() {
    const query = input?.value.trim().toLowerCase() ?? '';
    if (!query) {
      if (posts.length) renderList(posts.slice(0, 5), '最近の記事');
      else renderMessage('キーワードを入力して記事を探せます');
      return;
    }
    const matched = posts.filter(
      (post) =>
        post.title.toLowerCase().includes(query) ||
        post.description.toLowerCase().includes(query) ||
        post.tags.some((t) => t.toLowerCase().includes(query)),
    );
    if (matched.length === 0) renderMessage('一致する記事が見つかりませんでした');
    else renderList(matched, `${matched.length}件の記事`);
  }

  async function openSearch() {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    update();
    await loadIndex();
    update();
  }

  openBtn?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', () => dialog?.close());
  input?.addEventListener('input', update);

  // 背景クリックで閉じる
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => {
    if (input) input.value = '';
  });

  // Ctrl+K / Cmd+K で開く
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openSearch();
    }
  });
</script>

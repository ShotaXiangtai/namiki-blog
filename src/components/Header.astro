---
import { SITE_CONFIG } from '../config';
import { getRelativeUrl } from '../utils/url';
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = currentPath.startsWith(base) ? currentPath.slice(base.length) || '/' : currentPath;

const navLinks = [
  { href: '/tags/', label: 'タグ', active: path.startsWith('/tags') },
  { href: '/about/', label: 'プロフィール', active: path.startsWith('/about') },
];
---

<header class="bg-canvas">
  <div class="mx-auto flex h-12 max-w-[80rem] items-center gap-4 px-4 sm:h-16 sm:px-6">
    <!-- ロゴ（ブログ名） -->
    <a href={getRelativeUrl('/')} class="shrink-0 text-[1.0625rem] font-bold tracking-[0.04em] text-ink sm:text-lg">
      {SITE_CONFIG.title}
    </a>

    <!-- 検索ボックス（PC） -->
    <div class="flex min-w-0 flex-1 justify-center">
      <button
        type="button"
        data-search-open
        aria-haspopup="dialog"
        class="hidden h-10 w-full max-w-[32.5rem] items-center gap-2.5 rounded-md border border-line px-3 text-left text-sm text-ink-muted transition-colors hover:border-line-strong md:flex"
      >
        <Icon name="search" class="size-5 shrink-0" />
        <span class="flex-1 truncate">キーワードで記事を検索</span>
        <kbd id="search-shortcut" class="kbd">Ctrl K</kbd>
      </button>
    </div>

    <nav aria-label="メインメニュー" class="flex shrink-0 items-center gap-1">
      <button type="button" data-search-open aria-haspopup="dialog" aria-label="記事を検索" class="icon-btn md:hidden">
        <Icon name="search" class="size-5" />
      </button>
      {navLinks.map(({ href, label, active }) => (
        <a
          href={getRelativeUrl(href)}
          aria-current={active ? 'page' : undefined}
          class="hidden rounded-md px-3 py-2 text-[0.8125rem] font-bold text-ink transition-colors hover:bg-subtle aria-[current=page]:bg-subtle sm:inline-flex"
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<!-- 検索ダイアログ -->
<dialog id="search-dialog" class="search-dialog" aria-label="記事を検索">
  <div class="flex items-center gap-3 border-b border-line px-4">
    <Icon name="search" class="size-5 shrink-0 text-ink-muted" />
    <input
      id="search-input"
      type="search"
      placeholder="タイトル・概要・タグで検索"
      autocomplete="off"
      autofocus
      class="h-14 w-full bg-transparent text-base text-ink outline-none placeholder:text-ink-muted [&::-webkit-search-cancel-button]:hidden"
    />
    <button id="search-close" type="button" class="kbd shrink-0 cursor-pointer hover:text-ink">Esc</button>
  </div>
  <div id="search-results" class="max-h-[min(60vh,28rem)] overflow-y-auto p-2" aria-live="polite"></div>
</dialog>

<script>
  type SearchPost = { title: string; description: string; slug: string; tags: string[]; date: string };

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('search-close');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const results = document.getElementById('search-results');
  const shortcut = document.getElementById('search-shortcut');
  const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

  if (shortcut && /Mac|iPhone|iPad/.test(navigator.platform)) {
    shortcut.textContent = '⌘K';
  }

  let posts: SearchPost[] = [];
  let loading: Promise<void> | null = null;

  function loadIndex() {
    loading ??= fetch(`${baseUrl}/search-index.json`)
      .then((res) => (res.ok ? res.json() : []))
      .then((data: SearchPost[]) => {
        posts = data;
      })
      .catch((e) => console.error('Failed to load search index:', e));
    return loading;
  }

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const formatDate = (iso: string) =>
    new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(iso));

  function renderMessage(text: string) {
    if (results) results.innerHTML = `<p class="px-3 py-10 text-center text-sm text-ink-soft">${text}</p>`;
  }

  function renderList(list: SearchPost[], heading: string) {
    if (!results) return;
    results.innerHTML =
      `<p class="px-3 pb-1 pt-2 text-xs font-bold text-ink-soft">${heading}</p>` +
      list
        .map(
          (post) => `
        <a href="${baseUrl}/posts/${encodeURIComponent(post.slug)}/" class="block rounded-md px-3 py-2.5 transition-colors hover:bg-subtle focus-visible:bg-subtle">
          <span class="block text-[0.9375rem] font-bold leading-snug text-ink">${escapeHtml(post.title)}</span>
          <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-soft">
            <time>${formatDate(post.date)}</time>
            ${post.tags
              .slice(0, 3)
              .map((t) => `<span>#${escapeHtml(t)}</span>`)
              .join('')}
          </span>
        </a>`,
        )
        .join('');
  }

  function update() {
    const query = input?.value.trim().toLowerCase() ?? '';
    if (!query) {
      if (posts.length) renderList(posts.slice(0, 5), '最近の記事');
      else renderMessage('キーワードを入力して記事を探せます');
      return;
    }
    const matched = posts.filter(
      (post) =>
        post.title.toLowerCase().includes(query) ||
        post.description.toLowerCase().includes(query) ||
        post.tags.some((t) => t.toLowerCase().includes(query)),
    );
    if (matched.length === 0) renderMessage('一致する記事が見つかりませんでした');
    else renderList(matched, `${matched.length}件の記事`);
  }

  async function openSearch() {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    update();
    await loadIndex();
    update();
  }

  document.querySelectorAll('[data-search-open]').forEach((btn) => btn.addEventListener('click', openSearch));
  closeBtn?.addEventListener('click', () => dialog?.close());
  input?.addEventListener('input', update);

  // 背景クリックで閉じる
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => {
    if (input) input.value = '';
  });

  // Ctrl+K / Cmd+K で開く
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openSearch();
    }
  });
</script>

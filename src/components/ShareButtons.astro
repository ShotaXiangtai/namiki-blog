---
import Icon from './Icon.astro';

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const services = [
  { label: 'X でシェア', href: `https://twitter.com/intent/tweet?text=${t}&url=${u}`, icon: 'x' as const, size: 'size-4' },
  { label: 'Facebook でシェア', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, icon: 'facebook' as const, size: 'size-[1.125rem]' },
  { label: 'LINE で送る', href: `https://social-plugins.line.me/lineit/share?url=${u}`, icon: 'line' as const, size: 'size-[1.125rem]' },
];
const hatenaHref = `https://b.hatena.ne.jp/add?mode=confirm&url=${u}&title=${t}`;
---

<ul class="flex items-center" aria-label="この記事をシェア">
  {services.map(({ label, href, icon, size }) => (
    <li>
      <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} title={label} class="icon-btn">
        <Icon name={icon} class={size} />
      </a>
    </li>
  ))}
  <li>
    <a
      href={hatenaHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="はてなブックマークに追加"
      title="はてなブックマークに追加"
      class="icon-btn text-[0.8125rem] font-bold tracking-tight"
    >
      B!
    </a>
  </li>
  <li>
    <button type="button" data-copy-link={url} aria-label="リンクをコピー" title="リンクをコピー" class="icon-btn">
      <Icon name="link" class="size-[1.125rem]" />
    </button>
  </li>
</ul>

<script>
  import { showToast } from '../utils/toast';

  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copyLink || location.href);
        showToast('リンクをコピーしました');
      } catch (e) {
        console.error('Failed to copy', e);
      }
    });
  });
</script>

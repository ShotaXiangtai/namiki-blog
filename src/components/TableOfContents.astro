---
import type { MarkdownHeading } from 'astro';
import Icon from './Icon.astro';

interface Props {
  headings: MarkdownHeading[];
  class?: string;
}

const { headings, class: className = '' } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<!-- note の目次ボックス風：淡いグレーの面に、区切り線つきで見出しを並べる -->
<details open class:list={['toc rounded-sm bg-subtle px-4 pb-2 pt-3 sm:px-5', className]}>
  <summary class="inline-flex cursor-pointer list-none items-center gap-1 py-1 text-sm font-bold text-ink-soft hover:text-ink">
    <Icon name="caret-down" class="toc-caret size-4" />
    目次
  </summary>
  <ol class="mt-1">
    {items.map((h) => (
      <li class:list={['group', h.depth === 3 && 'pl-4']}>
        <a
          href={`#${h.slug}`}
          class="block border-t border-line py-2 text-sm leading-[1.6] text-ink-soft transition-colors hover:text-ink group-first:border-t-0"
        >
          {h.text}
        </a>
      </li>
    ))}
  </ol>
</details>

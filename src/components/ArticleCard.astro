---
import { getRelativeUrl, formatDate, estimateReadingTime } from '../utils/url';
import Icon from './Icon.astro';
import PostThumb from './PostThumb.astro';

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      heroImage?: string;
      tags: string[];
      pinned?: boolean;
      likes: number;
    };
  };
  /** 記事タイトルの見出しレベル（ページ内の見出し構造に合わせる） */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const readingTime = post.body ? estimateReadingTime(post.body) : 2;
const postUrl = getRelativeUrl(`/posts/${post.id}/`);
const visibleTags = post.data.tags.slice(0, 3);
const hiddenTagCount = post.data.tags.length - visibleTags.length;
---

<article class="group relative flex gap-4 rounded-2xl border border-line bg-surface p-4 transition duration-200 hover:border-line-strong hover:shadow-[0_8px_28px_-14px_rgb(0_0_0/0.22)] sm:gap-6 sm:p-5">
  <div class="flex min-w-0 flex-1 flex-col">
    <!-- メタ情報 -->
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-muted">
      {post.data.pinned && (
        <span class="inline-flex items-center gap-1 rounded-full bg-accent-soft px-2 py-0.5 font-bold text-accent-ink">
          <Icon name="pin" class="size-3" />
          固定
        </span>
      )}
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>約{readingTime}分</span>
    </div>

    <!-- タイトル（カード全体をクリック可能にする） -->
    <Heading class="headline mt-1.5 text-[1.0625rem] sm:line-clamp-3 font-bold leading-snug text-ink sm:text-lg">
      <a href={postUrl} class="transition-colors after:absolute after:inset-0 after:rounded-2xl group-hover:text-accent-ink">
        {post.data.title}
      </a>
    </Heading>

    <p class="mt-2 line-clamp-2 hidden text-sm leading-relaxed text-ink-soft sm:block">
      {post.data.description}
    </p>

    <!-- タグ & いいね -->
    <div class="mt-auto flex items-end justify-between gap-3 pt-3">
      <ul class="relative z-10 flex flex-wrap gap-x-2.5 gap-y-1 text-xs">
        {visibleTags.map((tag) => (
          <li>
            <a href={getRelativeUrl(`/tags/${tag}/`)} class="text-ink-muted transition-colors hover:text-accent-ink">
              #{tag}
            </a>
          </li>
        ))}
        {hiddenTagCount > 0 && <li class="text-ink-muted">+{hiddenTagCount}</li>}
      </ul>

      <span
        class="inline-flex shrink-0 items-center gap-1 text-xs text-ink-muted"
        title="いいね数"
        data-like-count={post.data.likes}
        data-post-id={post.id}
        hidden={post.data.likes === 0}
      >
        <Icon name="heart" class="size-3.5" />
        <span class="tabular-nums">{post.data.likes}</span>
      </span>
    </div>
  </div>

  <PostThumb
    heroImage={post.data.heroImage}
    tag={post.data.tags[0]}
    class="aspect-[4/3] w-24 shrink-0 self-start rounded-xl sm:aspect-[16/10] sm:w-44"
  />
</article>

<script>
  // この端末で「いいね」した記事はカウントに反映して表示する
  document.querySelectorAll<HTMLElement>('[data-like-count]').forEach((el) => {
    try {
      if (localStorage.getItem(`namiki_blog_like_${el.dataset.postId}`) !== 'true') return;
      const count = el.querySelector('span');
      if (count) count.textContent = String(Number(el.dataset.likeCount ?? 0) + 1);
      el.hidden = false;
    } catch {
      /* localStorage が使えない環境では何もしない */
    }
  });
</script>

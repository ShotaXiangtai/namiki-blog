---
import { SITE_CONFIG } from '../config';
import { getRelativeUrl, formatDate } from '../utils/url';
import Icon from './Icon.astro';
import PostThumb from './PostThumb.astro';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      pubDate: Date;
      heroImage?: string;
      tags: string[];
      likes: number;
    };
  };
  /** 記事タイトルの見出しレベル（ページ内の見出し構造に合わせる） */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const postUrl = getRelativeUrl(`/posts/${post.id}/`);
---

<!-- note のカード：アイキャッチ → タイトル → 著者・日付 → いいね数（スマホでは横並びのリスト） -->
<article class="group relative flex flex-row-reverse items-start gap-4 sm:flex-col sm:gap-0">
  <PostThumb
    heroImage={post.data.heroImage}
    title={post.data.title}
    tags={post.data.tags}
    class="w-28 shrink-0 rounded-md transition-opacity group-hover:opacity-85 sm:w-full"
  />

  <div class="min-w-0 flex-1 sm:mt-3 sm:w-full">
    <Heading class="headline line-clamp-3 text-[0.9375rem] font-bold leading-[1.6] text-ink">
      <a href={postUrl} class="after:absolute after:inset-0 group-hover:underline group-hover:underline-offset-2">
        {post.data.title}
      </a>
    </Heading>

    <div class="mt-2 flex min-w-0 items-center gap-1.5 text-xs text-ink-soft">
      <img
        src={getRelativeUrl(SITE_CONFIG.avatar)}
        alt=""
        width="18"
        height="18"
        loading="lazy"
        class="size-[1.125rem] shrink-0 rounded-full object-cover"
      />
      <span class="truncate">{SITE_CONFIG.author}</span>
      <time datetime={post.data.pubDate.toISOString()} class="ml-1 shrink-0">{formatDate(post.data.pubDate)}</time>
    </div>

    <div class="mt-2 flex items-center gap-1 text-sm text-ink-soft" data-card-like data-post-id={post.id} title="いいね数">
      <Icon name="heart" class="size-[1.125rem]" />
      <span class="tabular-nums" data-card-likes={post.data.likes}>{post.data.likes}</span>
    </div>
  </div>
</article>

<script>
  // この端末で「いいね」した記事はカウントとハートに反映する
  document.querySelectorAll<HTMLElement>('[data-card-like]').forEach((el) => {
    try {
      if (localStorage.getItem(`namiki_blog_like_${el.dataset.postId}`) !== 'true') return;
      const count = el.querySelector<HTMLElement>('[data-card-likes]');
      if (count) count.textContent = String(Number(count.dataset.cardLikes ?? 0) + 1);
      el.setAttribute('data-liked', '');
    } catch {
      /* localStorage が使えない環境では何もしない */
    }
  });
</script>

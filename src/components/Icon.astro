export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-4' } = Astro.props;
const icon: { svg: string; fill?: boolean } = ICONS[name];
const filled = icon.fill === true;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? undefined : 'currentColor'}
  stroke-width={filled ? undefined : 1.8}
  stroke-linecap={filled ? undefined : 'round'}
  stroke-linejoin={filled ? undefined : 'round'}
  set:html={icon.svg}
/>

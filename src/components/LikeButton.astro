---
import Icon from './Icon.astro';

interface Props {
  postId: string;
  initialLikes?: number;
  /**
   * inline: タイトル下の小さなハート / floating: 右下に浮かぶハート / full: 記事末尾のボタン
   * 同じページ内のいいねボタンはすべて同じ状態に同期する
   */
  variant?: 'inline' | 'floating' | 'full';
}

const { postId, initialLikes = 0, variant = 'full' } = Astro.props;

const variantClass = {
  inline: 'gap-1.5 text-[0.8125rem] text-ink-soft hover:text-heart',
  floating: 'gap-1.5 text-sm text-ink-soft hover:text-heart',
  full: 'h-10 gap-1.5 rounded-full border border-line-strong px-4 text-sm font-bold text-ink hover:border-heart hover:text-heart aria-pressed:border-heart',
}[variant];
const iconClass = variant === 'floating' ? 'size-6' : 'size-5';
---

<button
  type="button"
  data-like-button
  data-post-id={postId}
  data-initial-likes={initialLikes}
  aria-pressed="false"
  aria-label={`いいね ${initialLikes}`}
  class:list={['inline-flex items-center transition-colors aria-pressed:text-heart', variantClass]}
>
  <span data-like-icon class="inline-flex">
    <Icon name="heart" class={iconClass} />
  </span>
  {variant === 'full' && <span>いいね</span>}
  <span data-like-count class="tabular-nums">{initialLikes}</span>
</button>

<script>
  import { showToast } from '../utils/toast';

  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-like-button]')];
  const storageKey = (id: string) => `namiki_blog_like_${id}`;
  const liked = new Map<string, boolean>();

  const read = (id: string) => {
    try {
      return localStorage.getItem(storageKey(id)) === 'true';
    } catch {
      return false;
    }
  };
  const write = (id: string, value: boolean) => {
    try {
      localStorage.setItem(storageKey(id), String(value));
    } catch {
      /* 保存できない環境ではページ内だけで反映 */
    }
  };

  const render = (id: string) => {
    const isLiked = liked.get(id) ?? false;
    for (const btn of buttons) {
      if (btn.dataset.postId !== id) continue;
      const count = Number(btn.dataset.initialLikes ?? 0) + (isLiked ? 1 : 0);
      btn.setAttribute('aria-pressed', String(isLiked));
      btn.setAttribute('aria-label', `いいね ${count}`);
      const countEl = btn.querySelector('[data-like-count]');
      if (countEl) countEl.textContent = String(count);
    }
  };

  for (const btn of buttons) {
    const id = btn.dataset.postId ?? '';
    if (!liked.has(id)) {
      liked.set(id, read(id));
      render(id);
    }

    btn.addEventListener('click', () => {
      const next = !liked.get(id);
      liked.set(id, next);
      write(id, next);
      render(id);

      if (next) {
        showToast('いいね！ありがとうございます');
        const icon = btn.querySelector('[data-like-icon]');
        if (icon && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          icon.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.3)' }, { transform: 'scale(1)' }], {
            duration: 320,
            easing: 'cubic-bezier(.3,1.6,.6,1)',
          });
        }
      }
    });
  }
</script>

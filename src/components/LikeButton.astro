---
import Icon from './Icon.astro';

interface Props {
  postId: string;
  initialLikes?: number;
}

const { postId, initialLikes = 0 } = Astro.props;
---

<div class="flex flex-col items-center gap-2 sm:flex-row sm:gap-3">
  <button
    id="article-like-btn"
    type="button"
    data-post-id={postId}
    data-initial-likes={initialLikes}
    aria-pressed="false"
    class="group inline-flex items-center gap-2 rounded-full border border-line-strong bg-surface px-5 py-2.5 text-[0.9375rem] font-bold text-ink-soft transition hover:border-heart/50 hover:text-heart active:scale-95 aria-pressed:border-heart/60 aria-pressed:bg-heart/10 aria-pressed:text-heart"
  >
    <span id="like-heart-icon" class="inline-flex transition-transform duration-200 group-aria-pressed:[&>svg]:fill-current">
      <Icon name="heart" class="size-5" />
    </span>
    <span>いいね</span>
    <span id="like-count" class="tabular-nums">{initialLikes}</span>
  </button>

  <p id="like-message" class="text-xs text-ink-muted">記事が役に立ったら応援してください</p>
</div>

<script>
  const likeBtn = document.getElementById('article-like-btn');
  const heartIcon = document.getElementById('like-heart-icon');
  const likeCount = document.getElementById('like-count');
  const likeMessage = document.getElementById('like-message');

  if (likeBtn && likeCount) {
    const postId = likeBtn.dataset.postId || '';
    const initialLikes = parseInt(likeBtn.dataset.initialLikes || '0', 10);
    const storageKey = `namiki_blog_like_${postId}`;

    const read = () => {
      try {
        return localStorage.getItem(storageKey) === 'true';
      } catch {
        return false;
      }
    };
    const write = (value: boolean) => {
      try {
        localStorage.setItem(storageKey, String(value));
      } catch {
        /* 保存できない環境ではページ内だけで反映 */
      }
    };

    let isLiked = read();

    const render = () => {
      likeBtn.setAttribute('aria-pressed', String(isLiked));
      likeCount.textContent = String(initialLikes + (isLiked ? 1 : 0));
      if (likeMessage) {
        likeMessage.textContent = isLiked ? 'ありがとうございます！' : '記事が役に立ったら応援してください';
      }
    };

    render();

    likeBtn.addEventListener('click', () => {
      isLiked = !isLiked;
      write(isLiked);
      render();
      if (isLiked && heartIcon && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        heartIcon.animate(
          [{ transform: 'scale(1)' }, { transform: 'scale(1.35)' }, { transform: 'scale(1)' }],
          { duration: 320, easing: 'cubic-bezier(.3,1.6,.6,1)' },
        );
      }
    });
  }
</script>

---
import { SITE_CONFIG } from '../config';
import { getRelativeUrl } from '../utils/url';
import Icon from './Icon.astro';
---

<section aria-labelledby="author-heading" class="rounded-2xl border border-line bg-surface p-5 sm:p-6">
  <p id="author-heading" class="text-xs font-bold text-ink-muted">この記事を書いた人</p>

  <div class="mt-4 flex items-start gap-4">
    <a href={getRelativeUrl('/about/')} class="shrink-0">
      <img
        src={getRelativeUrl(SITE_CONFIG.avatar)}
        alt={SITE_CONFIG.author}
        width="64"
        height="64"
        loading="lazy"
        class="size-14 rounded-full object-cover ring-1 ring-line sm:size-16"
      />
    </a>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
        <div>
          <a href={getRelativeUrl('/about/')} class="font-bold text-ink hover:text-accent-ink">{SITE_CONFIG.author}</a>
          <p class="text-xs text-ink-muted">{SITE_CONFIG.handle}</p>
        </div>
        <div class="flex items-center gap-2">
          <a href={SITE_CONFIG.xUrl} target="_blank" rel="noopener noreferrer" class="icon-btn size-9" aria-label="X (Twitter)">
            <Icon name="x" class="size-3.5" />
          </a>
          <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener noreferrer" class="icon-btn size-9" aria-label="GitHub">
            <Icon name="github" class="size-4" />
          </a>
        </div>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-ink-soft">{SITE_CONFIG.bio}</p>
    </div>
  </div>
</section>

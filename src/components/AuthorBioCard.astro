---
import { SITE_CONFIG } from '../config';
import { getRelativeUrl } from '../utils/url';
import Icon from './Icon.astro';
---

<section aria-labelledby="author-heading" class="rounded-md bg-subtle p-5 sm:p-6">
  <h2 id="author-heading" class="sr-only">この記事を書いた人</h2>
  <div class="flex items-center gap-3">
    <a href={getRelativeUrl('/about/')} class="shrink-0">
      <img
        src={getRelativeUrl(SITE_CONFIG.avatar)}
        alt={SITE_CONFIG.author}
        width="48"
        height="48"
        loading="lazy"
        class="size-12 rounded-full object-cover"
      />
    </a>
    <div class="min-w-0 flex-1">
      <a href={getRelativeUrl('/about/')} class="font-bold text-ink hover:underline">{SITE_CONFIG.author}</a>
      <p class="text-xs text-ink-soft">{SITE_CONFIG.handle}</p>
    </div>
    <a href={SITE_CONFIG.xUrl} target="_blank" rel="noopener noreferrer" aria-label="X でフォロー" class="btn btn-primary h-8 shrink-0 gap-1 px-3 text-xs">
      <Icon name="x" class="size-3" />
      でフォロー
    </a>
  </div>
  <p class="mt-3 text-sm leading-[1.8] text-ink">{SITE_CONFIG.bio}</p>
</section>

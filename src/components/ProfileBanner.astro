---
import { SITE_CONFIG } from '../config';
import { getRelativeUrl } from '../utils/url';
import Icon from './Icon.astro';

interface Props {
  totalPosts?: number;
  totalTags?: number;
}

const { totalPosts = 0, totalTags = 0 } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 pt-4 sm:px-6 sm:pt-6">
  <!-- カバー画像（3:1 の比率のまま表示してトリミングしない） -->
  <div class="overflow-hidden rounded-2xl border border-line bg-subtle sm:rounded-3xl">
    <img
      src={getRelativeUrl(SITE_CONFIG.coverImage)}
      alt=""
      width="1024"
      height="341"
      fetchpriority="high"
      decoding="async"
      class="aspect-[3/1] w-full object-cover"
    />
  </div>

  <div class="px-1 sm:px-6">
    <!-- アバター & リンク -->
    <div class="-mt-8 flex items-end justify-between gap-3 sm:-mt-12">
      <img
        src={getRelativeUrl(SITE_CONFIG.avatar)}
        alt={SITE_CONFIG.author}
        width="96"
        height="96"
        class="relative size-[4.5rem] rounded-full border-4 border-canvas bg-surface object-cover shadow-sm sm:size-24"
      />
      <div class="flex items-center gap-2 pb-0.5">
        <a href={SITE_CONFIG.xUrl} target="_blank" rel="noopener noreferrer" class="icon-btn size-9 sm:size-[2.375rem]" aria-label="X (Twitter)">
          <Icon name="x" class="size-4" />
        </a>
        <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener noreferrer" class="icon-btn size-9 sm:size-[2.375rem]" aria-label="GitHub">
          <Icon name="github" class="size-[1.125rem]" />
        </a>
        <a href={getRelativeUrl('/rss.xml')} class="icon-btn size-9 sm:size-[2.375rem]" aria-label="RSS フィード">
          <Icon name="rss" class="size-4" />
        </a>
      </div>
    </div>

    <!-- 名前 & 自己紹介 -->
    <h1 class="headline mt-3 text-2xl font-bold tracking-tight text-ink">{SITE_CONFIG.author}</h1>
    <p class="text-sm text-ink-muted">{SITE_CONFIG.handle}</p>
    <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-soft">{SITE_CONFIG.bio}</p>

    <p class="mt-3 flex gap-5 text-sm text-ink-muted">
      <span><span class="font-bold tabular-nums text-ink">{totalPosts}</span> 記事</span>
      <span><span class="font-bold tabular-nums text-ink">{totalTags}</span> タグ</span>
    </p>
  </div>
</section>

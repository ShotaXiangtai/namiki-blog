---
import { SITE_CONFIG } from '../config';
import { getRelativeUrl } from '../utils/url';
---

<footer class="mt-auto bg-white border-t border-[#e8e8e8] py-12 text-sm text-gray-500">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pb-8 border-b border-gray-100">
      <div class="flex items-center gap-3">
        <img 
          src={getRelativeUrl(SITE_CONFIG.avatar)} 
          alt={SITE_CONFIG.title} 
          class="w-7 h-7 rounded-full border border-gray-200 object-cover shadow-2xs"
        />
        <span class="font-bold text-gray-800 text-base">{SITE_CONFIG.title}</span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 text-sm font-medium">
        <a href={getRelativeUrl('/')} class="hover:text-[#2cb696] transition-colors">ホーム</a>
        <a href={getRelativeUrl('/tags')} class="hover:text-[#2cb696] transition-colors">タグ一覧</a>
        <a href={getRelativeUrl('/about')} class="hover:text-[#2cb696] transition-colors">著者紹介</a>
        <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#2cb696] transition-colors">GitHub</a>
      </div>
    </div>

    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
      <div>
        <p>© 2026 {SITE_CONFIG.author}. All rights reserved.</p>
        <p class="mt-1">
          文章・記事: <a href="https://creativecommons.org/licenses/by/4.0/deed.ja" target="_blank" rel="noopener noreferrer" class="hover:text-gray-600 underline">CC BY 4.0</a> / ソースコード: <a href={getRelativeUrl('/LICENSE')} class="hover:text-gray-600 underline">MIT License</a>
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-gray-50 border border-gray-200 text-gray-500 font-mono text-[11px]">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          GitHub Pages
        </span>
      </div>
    </div>
  </div>
</footer>

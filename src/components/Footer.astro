---
import { SITE_CONFIG } from '../config';
import { getRelativeUrl } from '../utils/url';

const year = new Date().getFullYear();

const links = [
  { href: getRelativeUrl('/'), label: 'ホーム' },
  { href: getRelativeUrl('/tags/'), label: 'タグ一覧' },
  { href: getRelativeUrl('/about/'), label: 'プロフィール' },
  { href: getRelativeUrl('/rss.xml'), label: 'RSS' },
  { href: SITE_CONFIG.xUrl, label: 'X (Twitter)', external: true },
  { href: SITE_CONFIG.githubUrl, label: 'GitHub', external: true },
];
---

<footer class="border-t border-line bg-canvas">
  <div class="mx-auto max-w-[80rem] px-4 py-10 sm:px-6">
    <a href={getRelativeUrl('/')} class="text-[0.9375rem] font-bold tracking-[0.04em] text-ink">{SITE_CONFIG.title}</a>

    <nav aria-label="フッターメニュー" class="mt-4">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[0.8125rem] text-ink-soft">
        {links.map(({ href, label, external }) => (
          <li>
            <a
              href={href}
              class="transition-colors hover:text-ink"
              {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="mt-6 text-xs leading-relaxed text-ink-soft">
      © {year} {SITE_CONFIG.author}
      <span aria-hidden="true" class="mx-1.5">·</span>
      文章：<a href="https://creativecommons.org/licenses/by/4.0/deed.ja" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-ink">CC BY 4.0</a>
      <span aria-hidden="true" class="mx-1">/</span>
      コード：<a href={`${SITE_CONFIG.githubUrl}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-ink">MIT License</a>
    </p>
  </div>
</footer>

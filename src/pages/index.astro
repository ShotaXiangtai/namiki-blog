---
import { getPublishedPosts, sortPinnedFirst } from '../utils/posts';
import CreatorLayout from '../layouts/CreatorLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Icon from '../components/Icon.astro';

// 公開日時の過ぎた記事のみを取得（時間指定投稿対応）し、固定記事を先頭に
const posts = sortPinnedFirst(await getPublishedPosts());
const hasPinned = posts.some((p) => p.data.pinned);
---

<CreatorLayout active="posts">
  <section aria-labelledby="posts-heading" class="pt-6">
    <h2 id="posts-heading" class="sr-only">記事一覧</h2>

    {hasPinned && (
      <p class="mb-3 flex items-center gap-1 text-xs text-ink-soft">
        <Icon name="pin" class="size-3.5" />
        固定された記事
      </p>
    )}

    {posts.length > 0 ? (
      <ul class="card-grid xl:grid-cols-3">
        {posts.map((post) => (
          <li>
            <ArticleCard post={post} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="py-16 text-center text-sm text-ink-soft">まだ記事がありません</p>
    )}
  </section>
</CreatorLayout>

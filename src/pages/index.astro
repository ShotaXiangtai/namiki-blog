---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileBanner from '../components/ProfileBanner.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getRelativeUrl } from '../utils/url';

// 記事を日付順（新しい順）でソート
const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// タグ一覧と出現頻度を集計
const allTags = [...new Set(posts.flatMap(p => p.data.tags))];
const tagCounts = allTags.map(tag => ({
  name: tag,
  count: posts.filter(p => p.data.tags.includes(tag)).length
})).sort((a, b) => b.count - a.count);
---

<BaseLayout>
  <!-- 著者プロフィールバナー -->
  <ProfileBanner totalPosts={posts.length} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- メインコンテンツ（記事一覧） -->
      <section class="lg:col-span-8">
        <!-- ナビゲーションタブ（note風） -->
        <div class="flex items-center justify-between border-b border-gray-200 pb-3 mb-6">
          <div class="flex items-center gap-6 text-sm font-bold">
            <span class="text-gray-900 border-b-2 border-[#2cb696] pb-3 -mb-3 inline-block">
              すべての記事 ({posts.length})
            </span>
          </div>
          <span class="text-xs text-gray-400">新しい順</span>
        </div>

        <!-- 記事一覧リスト -->
        <div class="space-y-4">
          {sortedPosts.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>
      </section>

      <!-- サイドバー -->
      <aside class="lg:col-span-4 space-y-6">
        <!-- タグ一覧カード -->
        <div class="bg-white border border-[#e8e8e8] rounded-xl p-5 shadow-2xs">
          <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-3 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-[#2cb696]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
            人気のタグ
          </h3>
          <div class="flex flex-wrap gap-2">
            {tagCounts.map(({ name, count }) => (
              <a 
                href={getRelativeUrl(`/tags/${name}`)} 
                class="inline-flex items-center gap-1.5 text-xs text-gray-600 bg-gray-50 hover:bg-emerald-50 hover:text-[#2cb696] border border-gray-100 rounded-lg px-2.5 py-1.5 transition-colors"
              >
                <span>#{name}</span>
                <span class="text-[10px] text-gray-400 bg-white px-1.5 py-0.2 rounded-full border border-gray-100">{count}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- note風 記事作成ガイドカード -->
        <div class="bg-gradient-to-br from-emerald-50/70 via-teal-50/40 to-white border border-emerald-100/80 rounded-xl p-5">
          <div class="flex items-center gap-2 mb-2 text-[#2cb696]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <h4 class="font-bold text-sm text-gray-900">記事の投稿方法</h4>
          </div>
          <p class="text-xs text-gray-600 leading-relaxed mb-3">
            <code>src/content/blog/</code> に Markdown ファイル（<code>.md</code>）を追加して push するだけで自動公開されます。
          </p>
          <a 
            href={getRelativeUrl('/about')} 
            class="text-xs font-semibold text-[#2cb696] hover:text-[#20876f] flex items-center gap-1"
          >
            詳しく見る &rarr;
          </a>
        </div>
      </aside>

    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRelativeUrl } from '../utils/url';
---

<BaseLayout title="ページが見つかりませんでした (404)">
  <div class="max-w-xl mx-auto px-4 py-24 text-center">
    <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-[#2cb696] flex items-center justify-center mx-auto mb-6 text-2xl font-bold">
      404
    </div>
    <h1 class="text-2xl font-bold text-gray-900 mb-3">ページが見つかりませんでした</h1>
    <p class="text-sm text-gray-500 mb-8 leading-relaxed">
      お探しの記事は移動または削除されたか、URLが間違っている可能性があります。
    </p>
    <a 
      href={getRelativeUrl('/')} 
      class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#2cb696] hover:bg-[#279d81] text-white text-sm font-bold transition-all shadow-sm"
    >
      トップページへ戻る
    </a>
  </div>
</BaseLayout>

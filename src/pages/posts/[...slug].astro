---
import { render } from 'astro:content';
import { getPublishedPosts } from '../../utils/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LikeButton from '../../components/LikeButton.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import AuthorBioCard from '../../components/AuthorBioCard.astro';
import { SITE_CONFIG } from '../../config';
import { getRelativeUrl, formatDate, estimateReadingTime } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 公開済み記事の中から前後の記事を取得
const sortedPosts = await getPublishedPosts();
const currentIndex = sortedPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const readingTime = post.body ? estimateReadingTime(post.body) : 3;
---

<BaseLayout 
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  article={true}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- 記事ヘッダー -->
    <header class="mb-8">
      <!-- カテゴリ / タグ -->
      <div class="flex flex-wrap gap-2 mb-4">
        {post.data.tags.map((tag) => (
          <a 
            href={getRelativeUrl(`/tags/${tag}`)} 
            class="text-xs font-semibold text-[#2cb696] bg-[#eaf7f4] hover:bg-[#d6f0ea] px-2.5 py-1 rounded-full transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>

      <!-- タイトル -->
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight tracking-tight mb-6">
        {post.data.title}
      </h1>

      <!-- 著者 & メタ情報バー -->
      <div class="flex items-center justify-between pb-6 border-b border-gray-200">
        <div class="flex items-center gap-3">
          <a href={getRelativeUrl('/about')} class="shrink-0">
            <img 
              src={getRelativeUrl(SITE_CONFIG.avatar)} 
              alt={SITE_CONFIG.author} 
              class="w-10 h-10 rounded-full border border-gray-200 object-cover"
            />
          </a>
          <div>
            <div class="flex items-center gap-2">
              <a href={getRelativeUrl('/about')} class="text-sm font-bold text-gray-900 hover:text-[#2cb696] transition-colors">
                {SITE_CONFIG.author}
              </a>
            </div>
            <div class="flex items-center gap-2 text-xs text-gray-500">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <span>•</span>
              <span class="inline-flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10" stroke-width="2"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2"/>
                </svg>
                約{readingTime}分で読めます
              </span>
            </div>
          </div>
        </div>

      </div>
    </header>

    <!-- アイキャッチ画像 -->
    {post.data.heroImage && (
      <div class="mb-10 rounded-xl overflow-hidden shadow-xs bg-gray-100 aspect-16/9">
        <img 
          src={post.data.heroImage} 
          alt={post.data.title} 
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <!-- 目次（見出しが2つ以上ある場合に表示） -->
    {headings.length > 1 && (
      <nav class="my-8 p-5 bg-gray-50/90 rounded-xl border border-gray-200/80">
        <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-3 flex items-center gap-2">
          <svg class="w-4 h-4 text-[#2cb696]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
          目次
        </h2>
        <ul class="space-y-2 text-sm">
          {headings.filter(h => h.depth <= 3).map((h) => (
            <li class={`${h.depth === 3 ? 'ml-4 text-xs text-gray-600' : 'text-gray-700 font-medium'}`}>
              <a href={`#${h.slug}`} class="hover:text-[#2cb696] hover:underline transition-colors block py-0.5">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- 記事本文 -->
    <div class="article-content">
      <Content />
    </div>

    <!-- note風 スキボタン -->
    <LikeButton postId={post.id} initialLikes={post.data.likes} />

    <!-- SNSシェアボタン -->
    <ShareButtons title={post.data.title} />

    <!-- 前後の記事へのナビゲーション -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-10 pt-6 border-t border-gray-200">
      {prevPost ? (
        <a 
          href={getRelativeUrl(`/posts/${prevPost.id}`)} 
          class="p-4 rounded-xl border border-gray-200 hover:border-[#2cb696] hover:bg-emerald-50/30 transition-all flex flex-col justify-between group"
        >
          <span class="text-xs text-gray-400 font-medium mb-1">&larr; 前の記事</span>
          <span class="text-sm font-bold text-gray-800 group-hover:text-[#2cb696] line-clamp-2 transition-colors">
            {prevPost.data.title}
          </span>
        </a>
      ) : <div />}

      {nextPost ? (
        <a 
          href={getRelativeUrl(`/posts/${nextPost.id}`)} 
          class="p-4 rounded-xl border border-gray-200 hover:border-[#2cb696] hover:bg-emerald-50/30 transition-all flex flex-col justify-between text-right group"
        >
          <span class="text-xs text-gray-400 font-medium mb-1">次の記事 &rarr;</span>
          <span class="text-sm font-bold text-gray-800 group-hover:text-[#2cb696] line-clamp-2 transition-colors">
            {nextPost.data.title}
          </span>
        </a>
      ) : <div />}
    </div>

    <!-- 記事末尾の著者プロフィールカード -->
    <AuthorBioCard />
  </article>
</BaseLayout>

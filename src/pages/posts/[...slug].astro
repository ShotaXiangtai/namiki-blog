---
import { render } from 'astro:content';
import { getPublishedPosts, getRelatedPosts } from '../../utils/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LikeButton from '../../components/LikeButton.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import AuthorBioCard from '../../components/AuthorBioCard.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PostThumb from '../../components/PostThumb.astro';
import Icon from '../../components/Icon.astro';
import { SITE_CONFIG } from '../../config';
import { getRelativeUrl, formatDate, estimateReadingTime } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 公開済み記事から関連記事（足りない分は新着）を取得
const relatedPosts = getRelatedPosts(post, await getPublishedPosts(), 4);

const readingTime = post.body ? estimateReadingTime(post.body) : 3;
const showToc = headings.filter((h) => h.depth === 2 || h.depth === 3).length > 1;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? SITE_CONFIG.siteUrl).href;
const updated =
  post.data.updatedDate && post.data.updatedDate.valueOf() > post.data.pubDate.valueOf()
    ? post.data.updatedDate
    : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  article={true}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  tags={post.data.tags}
>
  <div class="mx-auto max-w-[80rem] px-4 sm:px-6 xl:grid xl:grid-cols-[minmax(0,1fr)_38.75rem_minmax(0,1fr)] xl:gap-10">
    <!-- 著者（広い画面では左側に表示） -->
    <aside class="hidden xl:block" aria-label="著者">
      <div class="sticky top-0 w-[13.5rem] pt-10">
        <a href={getRelativeUrl('/about/')} class="group flex items-center gap-3">
          <img
            src={getRelativeUrl(SITE_CONFIG.avatar)}
            alt=""
            width="56"
            height="56"
            class="size-14 shrink-0 rounded-full object-cover"
          />
          <span class="text-[0.9375rem] font-bold text-ink group-hover:underline">{SITE_CONFIG.author}</span>
        </a>
        <p class="mt-4 text-xs leading-[1.7] text-ink-soft">{SITE_CONFIG.bio}</p>
        <a href={SITE_CONFIG.xUrl} target="_blank" rel="noopener noreferrer" aria-label="X でフォロー" class="btn btn-primary mt-4 h-8 gap-1 px-3 text-xs">
          <Icon name="x" class="size-3" />
          でフォロー
        </a>
      </div>
    </aside>

    <article class="mx-auto w-full max-w-[38.75rem] pb-20 pt-8 sm:pt-12" itemscope itemtype="https://schema.org/BlogPosting">
      <!-- アイキャッチ（記事専用の画像がなければ自動生成） -->
      <figure class="mb-10 sm:mb-12">
        <PostThumb heroImage={post.data.heroImage} title={post.data.title} tags={post.data.tags} eager class="w-full" />
      </figure>

      <h1 itemprop="headline" class="headline text-2xl font-bold leading-[1.5] text-ink sm:text-[2rem]">
        {post.data.title}
      </h1>

      <div class="mt-5">
        <LikeButton postId={post.id} initialLikes={post.data.likes} variant="inline" />
      </div>

      <!-- 著者・投稿日 -->
      <div class="mt-5 flex items-center gap-2.5">
        <a href={getRelativeUrl('/about/')} class="shrink-0" itemprop="author" itemscope itemtype="https://schema.org/Person">
          <img
            src={getRelativeUrl(SITE_CONFIG.avatar)}
            alt={SITE_CONFIG.author}
            width="32"
            height="32"
            class="size-8 rounded-full object-cover"
          />
          <meta itemprop="name" content={SITE_CONFIG.author} />
        </a>
        <div class="min-w-0 text-xs leading-snug">
          <a href={getRelativeUrl('/about/')} class="text-ink hover:underline">{SITE_CONFIG.author}</a>
          <p class="mt-0.5 flex flex-wrap gap-x-2 text-ink-soft">
            <time datetime={post.data.pubDate.toISOString()} itemprop="datePublished">{formatDate(post.data.pubDate)}</time>
            {updated && (
              <span>
                <time datetime={updated.toISOString()} itemprop="dateModified">{formatDate(updated)}</time> 更新
              </span>
            )}
            <span>約{readingTime}分で読めます</span>
          </p>
        </div>
      </div>

      {showToc && <TableOfContents headings={headings} class="mt-10" />}

      <!-- 本文 -->
      <div class="article-content mt-10" itemprop="articleBody">
        <Content />
      </div>

      <!-- ハッシュタグ -->
      {post.data.tags.length > 0 && (
        <ul class="mt-14 flex flex-wrap gap-2" aria-label="タグ">
          {post.data.tags.map((tag) => (
            <li>
              <a href={getRelativeUrl(`/tags/${tag}/`)} class="hashtag">#{tag}</a>
            </li>
          ))}
        </ul>
      )}

      <!-- いいね・シェア -->
      <div id="article-actions" class="mt-8 flex flex-wrap items-center justify-between gap-3 border-y border-line py-3">
        <LikeButton postId={post.id} initialLikes={post.data.likes} variant="full" />
        <ShareButtons title={post.data.title} url={pageUrl} />
      </div>

      <div class="mt-10">
        <AuthorBioCard />
      </div>

      <!-- 関連記事 -->
      {relatedPosts.length > 0 && (
        <section aria-labelledby="related-heading" class="mt-16">
          <h2 id="related-heading" class="headline text-lg font-bold text-ink">あわせて読みたい</h2>
          <ul class="card-grid mt-5">
            {relatedPosts.map((related) => (
              <li>
                <ArticleCard post={related} />
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </div>

  <!-- 右下に浮かぶ いいね・シェア（PC） -->
  <div
    id="floating-actions"
    class="floating-actions fixed bottom-6 right-6 z-30 hidden items-center gap-1 rounded-full bg-canvas py-1 pl-3 pr-1 lg:flex"
  >
    <LikeButton postId={post.id} initialLikes={post.data.likes} variant="floating" />
    <button type="button" id="floating-share" class="icon-btn" aria-label="この記事をシェア" title="シェア">
      <Icon name="share" class="size-5" />
    </button>
  </div>
</BaseLayout>

<script>
  import { pageUrl, showToast } from '../../utils/toast';

  // ---- 右下のボタン：記事末尾のいいね欄やフッターが見えている間は隠す ----
  const floating = document.getElementById('floating-actions');
  const targets = [document.getElementById('article-actions'), document.querySelector('body > footer')].filter(
    (el): el is HTMLElement => el !== null,
  );
  if (floating && targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
      }
      floating.toggleAttribute('data-hidden', visible.size > 0);
    });
    targets.forEach((el) => observer.observe(el));
  }

  // ---- シェア：端末の共有機能、なければリンクをコピー ----
  document.getElementById('floating-share')?.addEventListener('click', async () => {
    const url = pageUrl();
    if (navigator.share) {
      try {
        await navigator.share({ title: document.title, url });
      } catch {
        /* キャンセル時は何もしない */
      }
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      showToast('リンクをコピーしました');
    } catch (e) {
      console.error('Failed to copy', e);
    }
  });

  // ---- コードブロックにコピーボタンを付与 ----
  document.querySelectorAll<HTMLPreElement>('.article-content pre').forEach((pre) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.append(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.textContent = 'コピー';
    button.setAttribute('aria-label', 'コードをコピー');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
        button.textContent = 'コピーしました';
        button.setAttribute('data-copied', '');
        setTimeout(() => {
          button.textContent = 'コピー';
          button.removeAttribute('data-copied');
        }, 2000);
      } catch (e) {
        console.error('Failed to copy', e);
      }
    });
    wrapper.append(button);
  });
</script>

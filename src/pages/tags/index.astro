---
import { getAllTags } from '../../utils/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelativeUrl } from '../../utils/url';

const tags = await getAllTags();
---

<BaseLayout title="タグ一覧" description="並木秀作のブログのタグ一覧です。関心のあるキーワードから記事を探せます。">
  <div class="mx-auto max-w-3xl px-4 pb-20 pt-10 sm:px-6 sm:pt-14">
    <header class="mb-8">
      <h1 class="headline text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">タグ一覧</h1>
      <p class="mt-2 text-sm text-ink-muted">関心のあるキーワードから記事を探せます（全{tags.length}件）</p>
    </header>

    <ul class="flex flex-wrap gap-2.5">
      {tags.map(({ name, count }) => (
        <li>
          <a href={getRelativeUrl(`/tags/${name}/`)} class="chip px-4 py-2 text-sm font-medium">
            #{name}
            <span class="chip-count rounded-full bg-subtle px-1.5 py-px text-xs">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

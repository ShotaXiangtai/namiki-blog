---
import { getAllTags } from '../../utils/posts';
import CreatorLayout from '../../layouts/CreatorLayout.astro';
import { getRelativeUrl } from '../../utils/url';

const tags = await getAllTags();
---

<CreatorLayout active="tags" title="タグ一覧" description="並木秀作のブログのタグ一覧です。関心のあるキーワードから記事を探せます。">
  <section class="pt-6">
    <h1 class="headline text-lg font-bold text-ink">
      タグ一覧
      <span class="ml-1 text-sm font-normal tabular-nums text-ink-soft">{tags.length}</span>
    </h1>

    <ul class="mt-5 flex flex-wrap gap-2.5">
      {tags.map(({ name, count }) => (
        <li>
          <a href={getRelativeUrl(`/tags/${name}/`)} class="hashtag">
            #{name}
            <span class="hashtag-count">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</CreatorLayout>

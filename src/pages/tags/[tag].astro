---
import { getPublishedPosts } from '../../utils/posts';
import CreatorLayout from '../../layouts/CreatorLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { getRelativeUrl } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const allTags = [...new Set(posts.flatMap((p) => p.data.tags))];

  return allTags.map((tag) => {
    const filteredPosts = posts.filter((p) => p.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<CreatorLayout
  active="tags"
  exact={false}
  title={`#${tag} の記事一覧`}
  description={`「${tag}」タグが付いた記事の一覧です（${posts.length}件）。`}
>
  <section class="pt-6">
    <a href={getRelativeUrl('/tags/')} class="inline-flex items-center gap-1 text-xs text-ink-soft hover:text-ink">
      <Icon name="arrow-left" class="size-3.5" />
      タグ一覧
    </a>
    <h1 class="headline mt-2 text-2xl font-bold text-ink">#{tag}</h1>
    <p class="mt-1 text-sm text-ink-soft">{posts.length}件の記事</p>

    <ul class="card-grid mt-6 xl:grid-cols-3">
      {posts.map((post) => (
        <li>
          <ArticleCard post={post} headingLevel={2} />
        </li>
      ))}
    </ul>
  </section>
</CreatorLayout>
